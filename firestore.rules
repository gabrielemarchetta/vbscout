rules_version = '2';
// Regole di sicurezza di Firestore per VBScout.
// Copia di quelle pubblicate nel pannello Firebase (Firestore Database → Regole): tenerle allineate.
service cloud.firestore {
  match /databases/{database}/documents {

    // LICENZE: ogni utente legge SOLO la propria; nessuno può scriverla dall'app
    // (si creano dal pannello Firebase, che ha i permessi di amministratore)
    match /licenze/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // DISPOSITIVI: il dispositivo su cui vale la licenza (piani diversi da "gold").
    // L'utente registra il primo dispositivo e può spostarlo al massimo ogni 7 giorni.
    // Per liberarlo prima: cancella il documento dal pannello.
    match /dispositivi/{uid} {
      function validDevice() {
        return request.resource.data.keys().hasOnly(['id', 'at'])
          && request.resource.data.id is string
          && request.resource.data.id.size() == 8
          && request.resource.data.at == request.time;
      }
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && validDevice();
      allow update: if request.auth != null && request.auth.uid == uid && validDevice()
                    && resource.data.at < request.time - duration.value(7, 'd');
      allow delete: if false;
    }

    // tutto il resto è chiuso
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
